# QADAM frontend — пример переменных окружения.
# Скопируйте в .env.local (не коммитится) при необходимости.

# Production: полный URL backend (без хвостового /), например:
# VITE_API_BASE_URL=https://qadam-backend.onrender.com
# Development: не задавать — запросы идут через Vite dev-proxy на :8080.
VITE_API_BASE_URL=
