# QADAM backend — пример переменных окружения.
# Скопируйте в .env (не коммитится) при локальном запуске без docker compose.

APP_ENV=development
PORT=8080

# PostgreSQL (локальный docker compose)
DATABASE_URL=postgres://qadam:qadam@localhost:5432/qadam?sslmode=disable
MIGRATIONS_PATH=migrations

# JWT — обязательно заменить на случайные значения (openssl rand -base64 32)
JWT_ACCESS_SECRET=<YOUR_SECRET>
JWT_REFRESH_SECRET=<YOUR_SECRET>

# CORS в production: origin'ы фронтенда через запятую
# ALLOWED_ORIGINS=https://qadam.vercel.app

# Локальное файловое хранилище материалов
MATERIALS_DIR=/tmp/qadam-materials
