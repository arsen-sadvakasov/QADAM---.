# QADAM — пример переменных окружения для локальной разработки (docker compose).
# Скопируйте в .env и при необходимости измените значения.
# Не коммитьте реальный .env с секретами в репозиторий.

# --- PostgreSQL ---
POSTGRES_USER=qadam
POSTGRES_PASSWORD=qadam
POSTGRES_DB=qadam

# --- Backend ---
APP_ENV=development
PORT=8080
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# --- MinIO (S3-совместимое хранилище файлов) ---
MINIO_ACCESS_KEY=qadam
MINIO_SECRET_KEY=qadam12345
MINIO_BUCKET=qadam-materials

# --- Redis ---
REDIS_URL=redis://redis:6379/0
